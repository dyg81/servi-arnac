# Copia estas variables a .env.local y reemplaza los valores de ejemplo.
# No uses estas credenciales fuera del entorno local.
APP_ENV=dev
APP_SECRET=replace-with-a-random-secret
DATABASE_URL=mysql://app:replace-local-password@db:3306/app?serverVersion=10.4.34-MariaDB
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=replace-local-password
MYSQL_ROOT_PASSWORD=replace-local-root-password
# APP_PORT=8080
# DB_PORT=3307
