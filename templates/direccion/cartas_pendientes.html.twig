{% extends 'layout.html.twig' %}

{% block title %}
    Dirección | Autorizos Pendientes
{% endblock %}

{% block menu %}
    <div class="sidebar text-sm">
        <nav class="mt-4">
            <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                <li class="nav-item">
                    <a href="{{ path('direccion_estadisticas') }}" class="nav-link">
                        <i class="nav-icon far fa-chart-bar"></i>
                        <p>Estadísticas</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('direccion_reportes') }}" class="nav-link">
                        <i class="nav-icon far fa-cogs"></i>
                        <p>Reportes</p>
                    </a>
                </li>
                <li class="nav-item has-treeview menu-open">
                    <a href="#" class="nav-link active">
                        <i class="nav-icon far fa-file-chart-line"></i>
                        <p>
                            Autorizos
                            <i class="right fas fa-angle-right"></i>
                        </p>
                    </a>
                    <ul class="nav nav-treeview">
                        <li class="nav-item">
                            <a href="#" class="nav-link active">
                                <i class="far fa-circle nav-icon" style="font-size: 0.875em"></i>
                                <p style="font-size: 0.875em">Pendientes</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="{{ path('direccion_listar_cartas_respondidas') }}" class="nav-link">
                                <i class="far fa-circle nav-icon" style="font-size: 0.875em"></i>
                                <p style="font-size: 0.875em">Completados</p>
                            </a>
                        </li>
                    </ul>
                </li>
            </ul>
        </nav>
    </div>
{% endblock %}

{% block content %}
    <div class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card card-primary card-outline card-tabs mt-2">
                        <div class="card-header p-0 pt-1 border-bottom-0">
                            <ul class="nav nav-tabs">
                                <li class="nav-item">
                                    <a class="nav-link active font-italic font-weight-bolder">Gestión de Autorizos</a>
                                </li>
                            </ul>
                        </div>
                        <div id="table_wrapper" class="card-body">
                            <table id="sac" class="table table-hover table-striped display nowrap" style="width: 100%;">
                                <thead>
                                <tr>
                                    <th>Cliente</th>
                                    <th>Centro Laboral</th>
                                    <th>Solicitado</th>
                                    <th style="width: 10px"></th>
                                    <th style="width: 10px"></th>
                                </tr>
                                </thead>
                                <tbody class="text-muted">
                                {% for carta in cartas %}
                                    <tr>
                                        <td>
                                            <a href="{{ path('direccion_descargar_carta', {'id': carta.id}) }}" class="font-italic text-white" target="_blank" data-toggle="tooltip" data-placement="top" data-container=".content-wrapper" title="Ver carta">{{ carta.cliente }}</a>
                                        </td>
                                        <td>{{ carta.cliente.centroLaboral }}</td>
                                        <td>{{ carta.fechaSolicitud | date("d-m-Y") }}</td>
                                        <td>
                                            <a href="{{ path('direccion_aprobar_carta_pendiente', {'id': carta.id}) }}" class="btn btn-xs btn-success modal-open">
                                                Aprobar
                                            </a>
                                        </td>
                                        <td>
                                            <a href="{{ path('direccion_denegar_carta_pendiente', {'id': carta.id}) }}" class="btn btn-xs btn-danger mr-2 modal-open">
                                                Denegar
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block notificationes %}
    {{ include('direccion/_direccion_notifications.html.twig') }}
{% endblock %}
