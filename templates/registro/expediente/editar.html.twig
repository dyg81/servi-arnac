{% extends '@Dyg81Modal/baseModal.html.twig' %}

{% block modalBackdrop %}
    data-backdrop="static"
{% endblock %}

{% block modalContent %}
    {{ form_start(form, {'action': path('registro_editar_expediente', {'id': expediente.id})}) }}
        <div class="modal-header">
            <h5 class="modal-title text-muted pl-2">
                <span class="fa fa-check-circle pr-2"></span>
                Expediente
            </h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">×</span>
            </button>
        </div>
        <div class="modal-body text-xs">
            <div class="row">
                <div class="form-group sac-form-group col-6">
                    <span class="far fa-file-alt form-control-feedback text-md"></span>
                    {{ form_widget(form.numero) }}
                </div>
            </div>
            <div class="row">
                <div class="form-group sac-form-group col-12">
                    <span class="far fa-comment-alt-lines form-control-feedback text-md"></span>
                    {{ form_widget(form.contenido) }}
                </div>
            </div>
            <div class="row">
                <div class="form-group col-12">
                    {{ form_widget(form.fondo) }}
                </div>
            </div>
            <div class="row">
                <div class="form-group col-6">
                    {{ form_widget(form.deposito) }}
                </div>
                <div class="form-group col-6">
                    {{ form_widget(form.estante) }}
                </div>
            </div>
            <div class="row">
                <div class="form-group col-6">
                    {{ form_widget(form.anaquel) }}
                </div>
                <div class="form-group col-6">
                    {{ form_widget(form.legajo) }}
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="submit" class="btn btn-sm btn-primary btn-save mr-2">Guardar</button>
            <button type="button" class="btn btn-sm btn-default" data-dismiss="modal">Cancelar</button>
        </div>
        {{ include('registro/expediente/_expediente_fondo_depositos.twig') }}
        {{ include('registro/expediente/_expediente_validator.twig') }}
    {{ form_end(form) }}
{% endblock %}
