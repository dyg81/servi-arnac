{% extends 'layout.html.twig' %}

{% block title %}
    Registro y Control | Expedientes
{% endblock %}

{% block menu %}
    <div class="sidebar text-sm">
        <nav class="mt-4">
            <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                <li class="nav-item">
                    <a href="{{ path('registro_listar_depositos') }}" class="nav-link">
                        <i class="nav-icon far fa-building"></i>
                        <p>Depósitos</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('registro_listar_estantes') }}" class="nav-link">
                        <i class="nav-icon far fa-line-columns"></i>
                        <p>Estantes</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('registro_listar_anaqueles') }}" class="nav-link">
                        <i class="nav-icon far fa-bars"></i>
                        <p>Anaqueles</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('registro_listar_fondos') }}" class="nav-link">
                        <i class="nav-icon far fa-clipboard"></i>
                        <p>Fondos Documentales</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('registro_listar_legajos') }}" class="nav-link">
                        <i class="nav-icon far fa-folder-open"></i>
                        <p>Legajos</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#" class="nav-link active">
                        <i class="nav-icon far fa-file-alt"></i>
                        <p>Expedientes</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('registro_listar_libros') }}" class="nav-link">
                        <i class="nav-icon far fa-book-alt"></i>
                        <p>Libros</p>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
{% endblock %}

{% block content %}
    <div class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card card-primary card-outline card-tabs mt-2">
                        <div class="card-header p-0 pt-1 border-bottom-0">
                            <ul class="nav nav-tabs">
                                <li class="nav-item">
                                    <a class="nav-link active font-italic font-weight-bolder">Gestión de expedientes</a>
                                </li>
                            </ul>
                        </div>
                        <div id="table_wrapper" class="card-body">
                            <div class="float-right pr-2">
                                <a href="{{ path('registro_agregar_expediente') }}" class="btn btn-primary btn-sm modal-open">
                                    <span class="icon"><i class="fas fa-plus"></i></span>
                                    <span class=""> Agregar</span>
                                </a>
                            </div>
                            <table id="sac" class="table table-hover table-striped display nowrap" style="width: 100%;">
                                <thead>
                                    <tr>
                                        <th scope="col">Número</th>
                                        <th scope="col">Fondo</th>
                                        <th scope="col">Ubicación</th>
                                        <th scope="col">Estado</th>
                                        <th scope="col" style="width: 1%"><span class="sr-only">Acciones</span></th>
                                        <th scope="col" style="width: 1%"><span class="sr-only">Acciones</span></th>
                                    </tr>
                                </thead>
                                <tbody class="text-muted">
                                {% for expediente in expedientes %}
                                    <tr>
                                        <td><span class="font-italic">{{ expediente.numero }}</span></td>
                                        <td>{{ expediente.fondo }}</td>
                                        <td>{{ expediente.deposito }} / {{ expediente.estante }} / {{ expediente.anaquel }} / {{ expediente.legajo }}</td>
                                        <td>
                                            {% if expediente.estado == constant('App\\Entity\\Expediente::EXP_ESTADO_ARCHIVADO_EN_DEPOSITO') %}
                                                <span class="badge badge-secondary text-white">{{ expediente.estadoExpediente | upper }}</span>
                                            {% elseif expediente.estado == constant('App\\Entity\\Expediente::EXP_ESTADO_RESERVADO_EN_SALA') %}
                                                <span class="badge badge-danger text-white">{{ expediente.estadoExpediente | upper }}</span>
                                            {% elseif expediente.estado == constant('App\\Entity\\Expediente::EXP_ESTADO_TRANS_TERMINADA') or expediente.estado == constant('App\\Entity\\Expediente::EXP_ESTADO_DIG_TERMINADA') %}
                                                <span class="badge badge-success text-white">{{ expediente.estadoExpediente | upper }}</span>
                                            {% else %}
                                                <span class="badge badge-warning text-white">{{ expediente.estadoExpediente | upper }}</span>
                                            {% endif %}
                                        </td>
                                        {% if expediente.estado == constant('App\\Entity\\Expediente::EXP_ESTADO_ARCHIVADO_EN_DEPOSITO') %}
                                            <td>
                                                <a href="{{ path('registro_editar_expediente', { 'id': expediente.id }) }}" class="text-muted modal-open" data-toggle="tooltip" data-placement="top" data-container=".content-wrapper" title="Editar">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                            </td>
                                            <td>
                                                <a href="{{ path('registro_eliminar_expediente', { 'id': expediente.id }) }}" class="text-muted mr-2 modal-open" data-toggle="tooltip" data-placement="top" data-container=".content-wrapper" title="Eliminar">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </td>
                                        {% else %}
                                            <td></td>
                                            <td></td>
                                        {% endif %}
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}