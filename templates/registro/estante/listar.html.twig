{% extends 'layout.html.twig' %}

{% block title %}
    Registro y Control | Estantes
{% endblock %}

{% block menu %}
    <div class="sidebar text-sm">
        <nav class="mt-4">
            <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                <li class="nav-item">
                    <a href="{{ path('registro_listar_depositos') }}" class="nav-link">
                        <i class="nav-icon far fa-building"></i>
                        <p>Depósitos</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#" class="nav-link active">
                        <i class="nav-icon far fa-line-columns"></i>
                        <p>Estantes</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('registro_listar_anaqueles') }}" class="nav-link">
                        <i class="nav-icon far fa-bars"></i>
                        <p>Anaqueles</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('registro_listar_fondos') }}" class="nav-link">
                        <i class="nav-icon far fa-clipboard"></i>
                        <p>Fondos Documentales</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('registro_listar_legajos') }}" class="nav-link">
                        <i class="nav-icon far fa-folder-open"></i>
                        <p>Legajos</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('registro_listar_expedientes') }}" class="nav-link">
                        <i class="nav-icon far fa-file-alt"></i>
                        <p>Expedientes</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('registro_listar_libros') }}" class="nav-link">
                        <i class="nav-icon far fa-book-alt"></i>
                        <p>Libros</p>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
{% endblock %}

{% block content %}
    <div class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card card-primary card-outline card-tabs mt-2">
                        <div class="card-header p-0 pt-1 border-bottom-0">
                            <ul class="nav nav-tabs">
                                <li class="nav-item">
                                    <a class="nav-link active font-italic font-weight-bolder">Gestión de estantes</a>
                                </li>
                            </ul>
                        </div>
                        <div id="table_wrapper" class="card-body">
                            <div class="float-right pr-2">
                                <a href="{{ path('registro_agregar_estante') }}" class="btn btn-primary btn-sm modal-open">
                                    <span class="icon"><i class="fas fa-plus"></i></span>
                                    <span class=""> Agregar</span>
                                </a>
                            </div>
                            <table id="sac" class="table table-hover table-striped display nowrap" style="width: 100%;">
                                <thead>
                                    <tr>
                                        <th>Estante</th>
                                        <th>Identificador</th>
                                        <th style="width: 1%"></th>
                                        <th style="width: 1%"></th>
                                    </tr>
                                </thead>
                                <tbody class="text-muted">
                                {% for estante in estantes %}
                                    <tr>
                                        <td><span class="font-italic">{{ estante.numero }}</span></td>
                                        <td>{{ estante }}</td>
                                        <td>
                                            <a href="{{ path('registro_editar_estante', { 'id': estante.id }) }}" class="text-muted modal-open" data-toggle="tooltip" data-placement="top" data-container=".content-wrapper" title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        </td>
                                        <td>
                                            <a href="{{ path('registro_eliminar_estante', { 'id': estante.id }) }}" class="text-muted mr-2 modal-open" data-toggle="tooltip" data-placement="top" data-container=".content-wrapper" title="Eliminar">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}