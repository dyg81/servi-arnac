<script>
    $(document).ready(function () {
        $('textarea').on('focus', function () {
            autosize($('textarea'));
        })
        $.fn.modal.Constructor.prototype._enforceFocus = function () {};

        $('#libro_anno').select2({
            theme: 'bootstrap4',
            width: 'style',
            placeholder: 'Años',
            allowClear: Boolean($('#libro_anno').data('allow-clear')),
            language: {
                noResults: function () {
                    return 'No hay resultados';
                }
            },
        });

        $('#libro_fondo').select2({
            theme: 'bootstrap4',
            width: 'style',
            placeholder: 'Fondos',
            allowClear: Boolean($('#libro_fondo').data('allow-clear')),
            language: {
                noResults: function () {
                    return 'No hay resultados';
                }
            },
        });

        $('#libro_deposito').select2({
            theme: 'bootstrap4',
            width: 'style',
            placeholder: 'Depósitos',
            allowClear: Boolean($('#libro_deposito').data('allow-clear')),
            language: {
                noResults: function () {
                    return 'No hay resultados';
                }
            },
        });

        $('#libro_estante').select2({
            theme: 'bootstrap4',
            width: 'style',
            placeholder: 'Estantes',
            allowClear: Boolean($('#libro_estante').data('allow-clear')),
            language: {
                noResults: function () {
                    return 'No hay resultados';
                }
            },
        });

        $('#libro_anaquel').select2({
            theme: 'bootstrap4',
            width: 'style',
            placeholder: 'Anaqueles',
            allowClear: Boolean($('#libro_anaquel').data('allow-clear')),
            language: {
                noResults: function () {
                    return 'No hay resultados';
                }
            },
        });

        $('input').on('input change', function(e) {
            $(e.target).valid();
        });

        $('textarea').on('input change', function(e) {
            $(e.target).valid();
        });

        $('select').on('input change', function(e) {
            $(e.target).valid();
        });

        $('.btn-save').click(function (e) {
            if (!$('#sac-form').valid()) {
                e.preventDefault()
            }
        });

        $('#sac-form').validate({
            ignore: [],
            rules: {
                'libro[tomo]': {
                    required: true,
                    digits: true,
                },
                'libro[anno]': {
                    required: true,
                },
                'libro[contenido]': {
                    required: true,
                },
                'libro[fondo]': {
                    required: true,
                },
                'libro[deposito]': {
                    required: true,
                },
                'libro[estante]': {
                    required: true,
                },
                'libro[anaquel]': {
                    required: true,
                },
            },
            messages: {
                'libro[tomo]': {
                    required: 'Este campo es obligatorio',
                    digits: 'Solo se permiten números',
                },
                'libro[anno]': {
                    required: 'Este campo es obligatorio',
                },
                'libro[contenido]': {
                    required: 'Este campo es obligatorio',
                },
                'libro[fondo]': {
                    required: 'Este campo es obligatorio',
                },
                'libro[deposito]': {
                    required: 'Este campo es obligatorio',
                },
                'libro[estante]': {
                    required: 'Este campo es obligatorio',
                },
                'libro[anaquel]': {
                    required: 'Este campo es obligatorio',
                },
            },
            errorElement: 'em',
            errorPlacement: function (error, element) {
                error.addClass('invalid-feedback');

                if (element.hasClass('select2-hidden-accessible')) {
                    error.insertAfter(element.next('.select2-container'));
                } else {
                    error.insertAfter(element);
                }
            },
            success: function (element) {
                $(element).closest('.form-control').addClass('is-valid').removeClass('is-invalid');
            },
            highlight: function (element) {
                $(element).closest('.form-control').removeClass('is-valid').addClass('is-invalid');
            },
            unhighlight: function (element) {
                $(element).closest('.form-control').addClass('is-valid').removeClass('is-invalid');
            },
        });
    });
</script>
