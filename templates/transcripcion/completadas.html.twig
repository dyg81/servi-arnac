{% extends 'layout.html.twig' %}

{% block title %}
    Transcripción | Completadas
{% endblock %}

{% block menu %}
    <div class="sidebar text-sm">
        <nav class="mt-4">
            <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                <li class="nav-item has-treeview menu-open mt-2">
                    <a href="#" class="nav-link active">
                        <i class="nav-icon far fa-sitemap"></i>
                        <p>
                            Servicios
                            <i class="right fas fa-angle-right"></i>
                        </p>
                    </a>
                    <ul class="nav nav-treeview">
                        <li class="nav-item">
                            <a href="{{ path('servicio_listar_transcripciones') }}" class="nav-link">
                                <i class="far fa-signature nav-icon" style="font-size: 0.875em"></i>
                                <p style="font-size: 0.875em">Solicitudes Nuevas</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="#" class="nav-link active">
                                <i class="far fa-outdent nav-icon" style="font-size: 0.875em"></i>
                                <p style="font-size: 0.875em">Solicitudes Completadas</p>
                            </a>
                        </li>
                    </ul>
                </li>
            </ul>
        </nav>
    </div>
{% endblock %}

{% block content %}
    <div class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card card-primary card-outline card-tabs mt-2">
                        <div class="card-header p-0 pt-1 border-bottom-0">
                            <ul class="nav nav-tabs">
                                <li class="nav-item">
                                    <a class="nav-link active font-italic font-weight-bolder">Transcripciones</a>
                                </li>
                            </ul>
                        </div>
                        <div id="table_wrapper" class="card-body">
                            <table id="sac" class="table table-hover table-striped display nowrap" style="width: 100%;">
                                <thead>
                                    <tr>
                                        <th>Cliente</th>
                                        <th>Fecha de Solicitud</th>
                                        <th>Fondo</th>
                                        <th>Documento</th>
                                        <th>Estado del Servicio</th>
                                    </tr>
                                </thead>
                                <tbody class="text-muted">
                                {% for transcripcion in transcripciones %}
                                    <tr>
                                        <td><span class="font-italic">{{ transcripcion.cliente }}</span></td>
                                        <td>{{ transcripcion.fechaSolicitud|date('d-m-Y / H:i') }}</td>
                                        <td>{{ transcripcion.documentoFondo }}</td>
                                        <td>{{ transcripcion.documentoNombre }}</td>
                                        <td>
                                            {% if transcripcion.estado == constant('App\\Entity\\Transcripcion::ESTADO_CANCELADO') %}
                                                <span class="badge badge-primary text-white">{{ transcripcion.estadoTranscripcion }} : {{ transcripcion.fechaActualizacion|date('d-m-Y / H:i') }}</span>
                                            {% elseif transcripcion.estado == constant('App\\Entity\\Transcripcion::ESTADO_TERMINADO') %}
                                                <span class="badge badge-success text-white">{{ transcripcion.estadoTranscripcion }} : {{ transcripcion.fechaActualizacion|date('d-m-Y / H:i') }}</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block notificationes %}
    {{ include('transcripcion/_transcripcion_notifications.html.twig') }}
{% endblock %}