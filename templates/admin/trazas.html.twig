{% extends 'layout.html.twig' %}

{% block title %}
    SAC | Admin
{% endblock %}

{% block menu %}
    <div class="sidebar text-sm">
        <nav class="mt-4">
            <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu"
                data-accordion="false">
                <li class="nav-item">
                    <a href="{{ path('admin_listar_usuarios') }}" class="nav-link">
                        <i class="nav-icon far fa-users"></i>
                        <p>Usuarios</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#" class="nav-link active">
                        <i class="nav-icon far fa-file-signature"></i>
                        <p>Seguridad</p>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
{% endblock %}

{% block content %}
    <div class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card card-primary card-outline card-tabs mt-2">
                        <div class="card-header p-0 pt-1 border-bottom-0">
                            <ul class="nav nav-tabs">
                                <li class="nav-item">
                                    <a class="nav-link active font-italic font-weight-bolder">Trazas del sistema</a>
                                </li>
                            </ul>
                        </div>
                        <div id="table_wrapper" class="card-body">
                            <table id="sac" class="table table-hover table-striped display nowrap" style="width: 100%;">
                                <thead>
                                <tr>
                                    <th></th>
                                    <th>Fecha</th>
                                    <th>Usuario</th>
                                    <th>Contenido</th>
                                </tr>
                                </thead>
                                <tbody class="text-muted">
                                {% for traza in trazas %}
                                    <tr>
                                        <td><i class="far fa-exclamation-triangle text-{{ traza.tipo }}"></i></td>
                                        <td>{{ traza.fecha|date('d-m-Y') }} / {{ traza.fecha|date('H:i') }}</td>
                                        <td>{{ traza.usuario }}</td>
                                        <td>{{ traza.contenido }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
