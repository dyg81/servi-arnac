{% extends '@Dyg81Modal/baseModal.html.twig' %}

{% block modalBackdrop %}
    data-backdrop="static"
{% endblock %}

{% block modalContent %}
    {{ form_start(form, {'action': path('admin_editar_perfil_usuario', {'id': usuario.id})}) }}
        <div class="modal-header">
            <h5 class="modal-title text-muted pl-2">
                <span class="fa fa-check-circle pr-2"></span>
                Editar Perfil
            </h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">×</span>
            </button>
        </div>
        <div class="modal-body text-xs">
            <div class="row">
                <div class="form-group sac-form-group col-12">
                    <span class="far fa-user-check form-control-feedback text-md"></span>
                    {{ form_widget(form.nombre) }}
                </div>
            </div>
            <div class="row">
                <div class="form-group sac-form-group col-6">
                    <span class="far fa-user-shield form-control-feedback text-md"></span>
                    {{ form_widget(form.usuario) }}
                </div>
                <div class="form-group sac-form-group col-6">
                    {{ form_widget(form.roles) }}
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="submit" class="btn btn-sm btn-primary btn-save mr-2">Guardar</button>
            <button type="button" class="btn btn-sm btn-default" data-dismiss="modal">Cancelar</button>
        </div>
        {{ include('admin/_admin_validator.html.twig') }}
    {{ form_end(form) }}
{% endblock %}