{% extends 'base.html.twig' %}

{% block body_classes %}login-page{% endblock %}

{% block body %}
    <div class="login-box" style="margin-top: -250px">
        <div class="error-page">
            <h2 class="headline text-danger">500</h2>
            <div class="error-content">
                <h5 class="text-justify"><i class="fas fa-exclamation-triangle text-danger"></i> Ha ocurrido un error inesperado.</h5>
                <div class="dropdown-divider"></div>
                <p class="text-justify text-sm">
                    Por favor notificar al administrador del sistema de forma inmediata.
                </p>
                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                    <p class="text-justify text-sm">
                        Sentimos las molestias ocasionadas. Para continuar trabajando, regrese a la <a href="{{ path(app.user.ruta) }}"> página matriz</a>.
                    </p>
                {% else %}
                    <p class="text-justify text-sm">
                        Sentimos las molestias ocasionadas. Para continuar trabajando, regrese a la <a href="{{ path('sac_login') }}" class="font-italic">página de inicio</a>.
                    </p>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}