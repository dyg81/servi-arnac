{% block content %}
    <div class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card card-primary card-outline card-tabs mt-2">
                        <div class="card-header p-0 pt-1 border-bottom-0">
                            <ul class="nav nav-tabs">
                                <li class="nav-item">
                                    <a class="nav-link active font-italic font-weight-bolder">Gestión de Libros</a>
                                </li>
                            </ul>
                        </div>
                        <div id="table_wrapper" class="card-body">
                            <table id="sac_libros" class="table table-hover table-striped display nowrap" style="width: 100%;">
                                <thead>
                                    <tr>
                                        <th scope="col">Año</th>
                                        <th scope="col">Tomo</th>
                                        <th scope="col">Fondo</th>
                                        <th scope="col">Ubicación</th>
                                        <th scope="col">Estado</th>
                                    </tr>
                                </thead>
                                <tbody class="text-muted">
                                {% for libro in libros %}
                                    <tr>
                                        <td><span class="font-italic">{{ libro.anno }}</span></td>
                                        <td><span class="font-italic">{{ libro.tomo }}</span></td>
                                        <td>{{ libro.fondo }}</td>
                                        <td>{{ libro.deposito }} / {{ libro.estante }} / {{ libro.anaquel }}</td>
                                        <td>
                                            {% if libro.estado == constant('App\\Entity\\Libro::LIB_ESTADO_ARCHIVADO_EN_DEPOSITO') %}
                                                <span class="badge badge-secondary text-white">{{ libro.estadolibro | upper }}</span>
                                            {% elseif libro.estado == constant('App\\Entity\\Libro::LIB_ESTADO_RESERVADO_EN_SALA') %}
                                                <span class="badge badge-danger text-white">{{ libro.estadolibro | upper }}</span>
                                            {% elseif libro.estado == constant('App\\Entity\\Libro::LIB_ESTADO_TRANS_TERMINADA') or libro.estado == constant('App\\Entity\\Libro::LIB_ESTADO_DIG_TERMINADA') %}
                                                <span class="badge badge-success text-white">{{ libro.estadolibro | upper }}</span>
                                            {% else %}
                                                <span class="badge badge-warning text-white">{{ libro.estadolibro | upper }}</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
