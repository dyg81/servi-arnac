{% block content %}
    <div class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card card-primary card-outline card-tabs mt-2">
                        <div class="card-header p-0 pt-1 border-bottom-0">
                            <ul class="nav nav-tabs">
                                <li class="nav-item">
                                    <a class="nav-link active font-italic font-weight-bolder">Gestión de cartas</a>
                                </li>
                            </ul>
                        </div>
                        <div id="table_wrapper" class="card-body">
                            <div class="float-right pr-2">
                                <a href="{{ path('sala_agregar_carta') }}" class="btn btn-primary btn-sm modal-open">
                                    <span class="icon"><i class="fas fa-plus"></i></span>
                                    <span class=""> Agregar</span>
                                </a>
                            </div>
                            <table id="sac" class="table table-hover table-striped display nowrap" style="width: 100%;">
                                <thead>
                                    <tr>
                                        <th scope="col">Cliente</th>
                                        <th scope="col" style="width: 14%">Solicitada</th>
                                        <th scope="col" style="width: 14%">Respondida</th>
                                        <th scope="col" style="width: 14%">Vigencia</th>
                                        <th scope="col" style="width: 14%">Estado</th>
                                        <th scope="col" style="width: 1%"><span class="sr-only">Acciones</span></th>
                                        <th scope="col" style="width: 1%"><span class="sr-only">Acciones</span></th>
                                        <th scope="col" style="width: 1%"><span class="sr-only">Acciones</span></th>
                                    </tr>
                                </thead>
                                <tbody class="text-muted">
                                {% for carta in cartas %}
                                    <tr>
                                        {% if carta.observaciones|length == 0 %}
                                            <td>
                                                <span class="font-italic">{{ carta.cliente }}</span>
                                            </td>
                                        {% else %}
                                            <td>
                                                <a href="{{ path('observacion_carta', {'id': carta.id}) }}" class="text-white font-italic modal-open" data-toggle="tooltip" data-placement="top" data-container=".content-wrapper" title="Observaciones">{{ carta.cliente }}</a>
                                            </td>
                                        {% endif %}
                                            <td>{{ carta.fechaSolicitud | date("d-m-Y") }}</td>
                                        {% if carta.estado == constant('App\\Entity\\Carta::CARTA_SOLICITADA') %}
                                            <td><span class="far fa-minus pl-3 text-md"></span></td>
                                            <td><span class="far fa-minus pl-3 text-md"></span></td>
                                            <td><span class="far fa-minus pl-3 text-md"></span></td>
                                            <td></td>
                                            <td>
                                                <a href="{{ path('sala_editar_carta', { 'id': carta.id }) }}" class="text-muted modal-open" data-toggle="tooltip" data-placement="top" data-container=".content-wrapper" title="Editar">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                            </td>
                                            <td>
                                                <a href="{{ path('sala_eliminar_carta', { 'id': carta.id }) }}" class="text-muted mr-2 modal-open" data-toggle="tooltip" data-placement="top" data-container=".content-wrapper" title="Eliminar">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </td>
                                        {% elseif carta.estado == constant('App\\Entity\\Carta::CARTA_APROBADA') %}
                                            <td>{{ carta.fechaRespuesta | date("d-m-Y") }}</td>
                                            <td>{{ carta.fechaVencimiento | date("d-m-Y") }}</td>
                                            <td><span class="badge badge-success text-white">APROBADA</span></td>
                                            <td>
                                                <a href="{{ path('sala_ver_fondos', {'id': carta.id}) }}" class="text-muted mr-2 modal-open" data-toggle="tooltip" data-placement="top" data-container=".content-wrapper" title="Ver fondos">
                                                    <i class="fas fa-clipboard"></i>
                                                </a>
                                            </td>
                                            <td></td>
                                            <td></td>
                                        {% elseif carta.estado == constant('App\\Entity\\Carta::CARTA_DENEGADA') %}
                                            <td>{{ carta.fechaRespuesta | date("d-m-Y") }}</td>
                                            <td><span class="far fa-minus pl-3 text-md"></span></td>
                                            <td><span class="badge badge-danger text-white">DENEGADA</span></td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                        {% else %}
                                            <td>{{ carta.fechaRespuesta | date("d-m-Y") }}</td>
                                            <td>{{ carta.fechaVencimiento | date("d-m-Y") }}</td>
                                            <td><span class="badge badge-warning text-white">VENCIDA</span></td>
                                            <td>
                                                <a href="{{ path('sala_ver_fondos', {'id': carta.id}) }}" class="text-muted mr-2 modal-open" data-toggle="tooltip" data-placement="top" data-container=".content-wrapper" title="Ver fondos">
                                                    <i class="fas fa-clipboard"></i>
                                                </a>
                                            </td>
                                            <td></td>
                                            <td></td>
                                        {% endif %}
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block notificationes %}
    {{ include('sala/_sala_notifications.html.twig') }}
{% endblock %}