{% extends '@Dyg81Modal/baseModal.html.twig' %}

{% block modalBackdrop %}
    data-backdrop="static"
{% endblock %}

{% block modalContent %}
    {{ form_start(form, {'action': path('sala_agregar_carta')}) }}
        <div class="modal-header">
            <h5 class="modal-title text-muted pl-2">
                <span class="fa fa-plus-circle pr-2"></span>
                Autorizos
            </h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">×</span>
            </button>
        </div>
        <div class="modal-body text-xs">
            <div class="form-group">
                {{ form_label(form.cliente, null, {'label_attr': {'class': 'sr-only'}}) }}
                {{ form_widget(form.cliente) }}
            </div>
            <div class="form-group">
                {{ form_label(form.documento_file, null, {'label_attr': {'class': 'sr-only'}}) }}
                {{ form_widget(form.documento_file) }}
            </div>
        </div>
        <div class="modal-footer">
            <button type="submit" class="btn btn-sm btn-primary btn-save mr-2">Guardar</button>
            <button type="button" class="btn btn-sm btn-default" data-dismiss="modal">Cancelar</button>
        </div>
        {{ include('sala/carta/_carta_validator.twig') }}
    {{ form_end(form) }}
{% endblock %}
