{% extends '@Dyg81Modal/baseModal.html.twig' %}

{% block modalSize %}
    modal-lg
{% endblock %}

{% block modalBackdrop %}
    data-backdrop="static"
{% endblock %}

{% block modalContent %}
    <div class="modal-header">
        <h5 class="modal-title m-0 font-weight-bold text-secondary">
            <i class="fas fa-fw fa-share-square"></i>
            Fondos Autorizados
        </h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">×</span>
        </button>
    </div>
    <div class="modal-body">
        <div class="callout callout-info mt-3">
            <h6 class="font-weight-bold">
                Cliente:
                <a class="font-weight-lighter text-decoration-none text-white-50">{{ carta.cliente }}</a>
            </h6>
            <div class="pt-2">
                <div class="dropdown-divider"></div>
                {% for fondo in carta.fondos %}
                    <span class="text-sm pl-2">
                        <i class="fas fa-angle-double-right"></i>
                        {{ fondo }}
                    </span>
                    <div class="dropdown-divider"></div>
                {% endfor %}
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <div class="col-3">
            <button type="button" class="btn btn-sm btn-default float-right" data-dismiss="modal">Cerrar</button>
        </div>
    </div>
{% endblock %}

