{% block content %}
    <div class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card card-primary card-outline card-tabs mt-2">
                        <div class="card-header p-0 pt-1 border-bottom-0">
                            <ul class="nav nav-tabs">
                                <li class="nav-item">
                                    <a class="nav-link active font-italic font-weight-bolder">Certificaciones</a>
                                </li>
                            </ul>
                        </div>
                        <div id="table_wrapper" class="card-body">
                            <table id="sac" class="table table-hover table-striped display nowrap" style="width: 100%;">
                                <thead>
                                    <tr>
                                        <th>Cliente</th>
                                        <th>Fecha/Hora de Solicitud</th>
                                        <th>Fondo</th>
                                        <th>Documento</th>
                                        <th>Estado del Servicio</th>
                                    </tr>
                                </thead>
                                <tbody class="text-muted">
                                {% for certificacion in certificaciones %}
                                    <tr>
                                        <td><span class="font-italic">{{ certificacion.cliente }}</span></td>
                                        <td>{{ certificacion.fechaSolicitud|date('d-m-Y / H:i') }}</td>
                                        <td>{{ certificacion.documentoFondo }}</td>
                                        <td>{{ certificacion.documentoNombre }}</td>
                                        <td>
                                            {% if certificacion.estado == constant('App\\Entity\\Certificacion::ESTADO_CANCELADO') %}
                                                <span class="badge badge-primary text-white">{{ certificacion.estadoCertificacion }} : {{ certificacion.fechaActualizacion|date('d-m-Y / H:i') }}</span>
                                            {% elseif certificacion.estado == constant('App\\Entity\\Certificacion::ESTADO_SOLICITADO') %}
                                                <span class="badge badge-info text-white">{{ certificacion.estadoCertificacion }} : {{ certificacion.fechaActualizacion|date('d-m-Y / H:i') }}</span>
                                            {% elseif certificacion.estado == constant('App\\Entity\\Certificacion::ESTADO_EN_PROCESO') %}
                                                <span class="badge badge-warning text-white">{{ certificacion.estadoCertificacion }} : {{ certificacion.fechaActualizacion|date('d-m-Y / H:i') }}</span>
                                            {% elseif certificacion.estado == constant('App\\Entity\\Certificacion::ESTADO_TERMINADO') %}
                                                <span class="badge badge-success text-white">{{ certificacion.estadoCertificacion }} : {{ certificacion.fechaActualizacion|date('d-m-Y / H:i') }}</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block notificationes %}
    {{ include('sala/_sala_notifications.html.twig') }}
{% endblock %}