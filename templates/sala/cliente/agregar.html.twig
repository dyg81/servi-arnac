{% extends '@Dyg81Modal/baseModal.html.twig' %}

{% block modalBackdrop %}
    data-backdrop="static"
{% endblock %}

{% block modalSize %}
{% endblock %}

{% block modalContent %}
    {{ form_start(form, {'action': path('sala_agregar_cliente')}) }}
        <div class="modal-header">
            <h5 class="modal-title text-muted pl-2">
                <span class="fa fa-plus-circle pr-2"></span>
                Cliente
            </h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">×</span>
            </button>
        </div>
        <div class="modal-body text-xs">
            <div class="row">
                <div class="form-group sac-form-group col-12">
                    <span class="far fa-user form-control-feedback"></span>
                    {{ form_label(form.nombre, null, {'label_attr': {'class': 'sr-only'}}) }}
                    {{ form_widget(form.nombre) }}
                </div>
            </div>
            <div class="row">
                <div class="form-group sac-form-group col-6">
                    <span class="far fa-passport form-control-feedback"></span>
                    {{ form_label(form.identificacion, null, {'label_attr': {'class': 'sr-only'}}) }}
                    {{ form_widget(form.identificacion) }}
                </div>
                <div class="form-group sac-form-group col-6">
                    <span class="far fa-phone form-control-feedback"></span>
                    {{ form_label(form.telefono, null, {'label_attr': {'class': 'sr-only'}}) }}
                    {{ form_widget(form.telefono) }}
                </div>
            </div>
            <div class="row">
                <div class="form-group sac-form-group col-12">
                    <span class="far fa-address-card form-control-feedback"></span>
                    {{ form_label(form.direccion, null, {'label_attr': {'class': 'sr-only'}}) }}
                    {{ form_widget(form.direccion) }}
                </div>
            </div>
            <div class="row">
                <div class="form-group sac-form-group col-12">
                    <span class="far fa-mail-bulk form-control-feedback"></span>
                    {{ form_label(form.correo, null, {'label_attr': {'class': 'sr-only'}}) }}
                    {{ form_widget(form.correo) }}
                </div>
            </div>
            <div class="row">
                <div class="form-group col-12">
                    {{ form_label(form.centro_laboral, null, {'label_attr': {'class': 'sr-only'}}) }}
                    {{ form_widget(form.centro_laboral) }}
                </div>
            </div>
            <div class="row">
                <div class="form-group col-12">
                    {{ form_label(form.pais, null, {'label_attr': {'class': 'sr-only'}}) }}
                    {{ form_widget(form.pais) }}
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="submit" class="btn btn-sm btn-primary btn-save mr-2">Guardar</button>
            <button type="button" class="btn btn-sm btn-default" data-dismiss="modal">Cancelar</button>
        </div>
        {{ include('sala/cliente/_cliente_validator.twig') }}
    {{ form_end(form) }}
{% endblock %}
