                        </li>
                        <li class="nav-item">
                            <a href="{{ path('sala_listar_reprografias') }}" class="nav-link">
                                <i class="far fa-scanner-image nav-icon" style="font-size: 0.875em"></i>
                                <p style="font-size: 0.875em">Reprografias</p>
