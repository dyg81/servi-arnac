                    </a>
                    <ul class="nav nav-treeview">
                        <li class="nav-item">
                            <a href="{{ path('sala_listar_paises') }}" class="nav-link">
                                <i class="far fa-flag nav-icon" style="font-size: 0.875em"></i>
                                <p style="font-size: 0.875em">Paises</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="#" class="nav-link active">
                                <i class="far fa-link nav-icon" style="font-size: 0.875em"></i>
                                <p style="font-size: 0.875em">Centros Laborales</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="{{ path('sala_listar_clientes') }}" class="nav-link">
                                <i class="far fa-user-friends nav-icon" style="font-size: 0.875em"></i>
                                <p style="font-size: 0.875em">Clientes</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="{{ path('sala_listar_cartas') }}" class="nav-link">
