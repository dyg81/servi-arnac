                        <li class="nav-item">
                            <a href="{{ path('sala_listar_certificaciones') }}" class="nav-link">
                                <i class="far fa-file-certificate nav-icon" style="font-size: 0.875em"></i>
                                <p style="font-size: 0.875em">Certificaciones</p>
