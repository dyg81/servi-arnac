{% block content %}
    <div class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card card-primary card-outline card-tabs mt-2">
                        <div class="card-header p-0 pt-1 border-bottom-0">
                            <ul class="nav nav-tabs">
                                <li class="nav-item">
                                    <a class="nav-link active font-italic font-weight-bolder">Gestión de Centros Laborales</a>
                                </li>
                            </ul>
                        </div>
                        <div id="table_wrapper" class="card-body">
                            <div class="float-right pr-2">
                                <div class="float-right pr-2">
                                    <a href="{{ path('sala_agregar_centro_laboral') }}" class="btn btn-primary btn-sm modal-open">
                                        <span class="icon"><i class="fas fa-plus"></i></span>
                                        <span class=""> Agregar</span>
                                    </a>
                                </div>
                            </div>
                            <table id="sac" class="table table-hover display nowrap" style="width: 100%;">
                                <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th style="width: 1%"></th>
                                    <th style="width: 1%"></th>
                                </tr>
                                </thead>
                                <tbody class="text-muted">
                                {% for centro in centros %}
                                    <tr>
                                        <td><span class="font-italic">{{ centro.nombre }}</span></td>
                                        <td>
                                            <a href="{{ path('sala_editar_centro_laboral', {'id': centro.id}) }}" class="text-muted modal-open" data-toggle="tooltip" data-placement="top" data-container=".content-wrapper" title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        </td>
                                        <td>
                                            <a href="{{ path('sala_eliminar_centro_laboral', {'id': centro.id}) }}" class="text-muted mr-2 modal-open" data-toggle="tooltip" data-placement="top" data-container=".content-wrapper" title="Eliminar">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block notificationes %}
    {{ include('sala/_sala_notifications.html.twig') }}
{% endblock %}

