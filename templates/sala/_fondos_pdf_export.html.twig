<script>
    $(document).ready(function () {
        $('#sac_fondos').DataTable({
            'ordering': false,
            'pageResize': true,
            'scrollX': '100%',
            'pagingType': 'full_numbers',
            buttons: [
                {
                    extend: 'pdf',
                    className: 'btn-sm btn-primary',
                    text: '<i class="far fa-file-pdf" />&nbsp;&nbsp;Exportar',

                    orientation: 'landscape',
                    pageSize: 'LETTER',

                    title: 'Fondos Documentales',
                    messageTop: 'Listado de Fondos Documentales',

                    customize: function (doc) {
                        doc.content.splice(0, 1, {
                            margin: [0, 0, 0, 12],
                            alignment: 'center',
                            image: 'data:image/png;base64,'
                        });

                        doc.content[2].table.widths = ['auto', '*', 'auto'];

                        doc.content[2].layout = {
                            hLineWidth: function(i, node) {
                                return (i === 0 || i === node.table.body.length) ? 1 : 1;},
                            vLineWidth: function(i, node) {
                                return (i === 0 || i === node.table.widths.length) ? 0 : 0;},
                            hLineColor: function(i, node) {
                                return (i === 0 || i === node.table.body.length) ? '#634c3c' : '#634c3c';},
                            vLineColor: function(i, node) {
                                return (i === 0 || i === node.table.widths.length) ? 'black' : 'gray';}
                        };

                        doc.footer = function(page, pages) {
                            return {
                                margin: [40, 10, 40, 0],
                                height: 30,
                                columns: [{
                                    alignment: "left",
                                    text: 'Generado por: ' + {{ app.user.nombre|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_QUOT'))|raw }} + ' el ' + new Date().toLocaleDateString('es-CL'),
                                }, {
                                    alignment: "right",
                                    text: [
                                        { text: 'Página ' + page.toString(), italics: true },
                                        " de ",
                                        { text: pages.toString(), italics: true }
                                    ]
                                }]
                            }
                        };

                        doc.styles = {
                            tableHeader: {
                                // alignment: 'center',
                                bold: true,
                                color: 'white',
                                fillColor: '#634c3c',
                                fontSize: 11,
                            },
                            // tableBodyEven: {
                            //     fillColor: '#cccccc'
                            // },
                            message: {
                                alignment: 'center',
                                bold: true,
                                color: '#634c3c',
                                fontSize: 20,
                            }
                        };
                    },
                }
            ],
            'language': {
                'url': '/assets/plugins/datatables/spanish.json'
            },
            dom: `<'row'<'col-sm-6 text-left'B><'col-sm-6 text-right'f>>
                  <'row'<'col-sm-12'tr>>
                  <'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>`,
            initComplete: function () {
                $('.buttons-pdf').removeClass('btn-secondary');
            },
        });
    })
</script>

