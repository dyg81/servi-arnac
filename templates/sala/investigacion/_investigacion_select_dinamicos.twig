<script>
    let clienteSelect = $('#investigacion_cliente');
    let fondoSelect = $('#investigacion_fondo');
    let legajoSelect = $('#investigacion_legajos');
    let expedienteSelect = $('#investigacion_expedientes');
    let libroSelect = $('#investigacion_libros');

    let primera_vez = true;

    function appendOption(select, value, label, attributes) {
        let option = $('<option>').val(String(value)).text(String(label));

        if (attributes) {
            option.prop(attributes);
        }

        select.append(option);
    }

    function errorMessage() {
        let inputText = 'Ha ocurrido un error desconocido mientras se cargaban los datos.';
        let font = '0.875rem Nimrod MT';

        let canvas = document.createElement('canvas');
        let context = canvas.getContext('2d');

        context.font = font;

        let width = context.measureText(inputText).width;
        let formattedWidth = Math.ceil(width) + 100;

        return Toast.fire({
            icon: 'error',
            title: inputText,
            width: formattedWidth,
        });
    }

    $(document).ready(function () {
            $.ajax({
                url: '{{ path('obtener_clientes_investigacion') }}',
                type: 'GET',
                dataType: 'JSON',
                success: function (clientes) {
                    clienteSelect.html('');
                    appendOption(clienteSelect, '', '', {hidden: true, disabled: true, selected: true});

                    $.each(clientes, function (key, cliente) {
                        appendOption(clienteSelect, cliente.id, cliente.nombre);
                    });
                },
                error: function () {
                    errorMessage()
                }
            });
        }
    )

    clienteSelect.change(function () {
        $.ajax({
            url: '{{ path('obtener_fondos_investigacion') }}',
            type: 'GET',
            dataType: 'JSON',
            data: {
                clienteid: clienteSelect.val()
            },
            success: function (fondos) {
                if (primera_vez) {
                    fondoSelect.prop('disabled', false).html('');
                    primera_vez = false;
                } else {
                    fondoSelect.prop('disabled', false).html('').valid();
                }

                legajoSelect.prop('disabled', true).html('');
                expedienteSelect.prop('disabled', true).html('');
                libroSelect.prop('disabled', true).html('');

                appendOption(fondoSelect, '', '', {hidden: true, disabled: true, selected: true});

                $.each(fondos, function (key, fondo) {
                    appendOption(fondoSelect, fondo.id, fondo.numero);
                });
            },
            error: function () {
                errorMessage()
            }
        });
    });

    fondoSelect.change(function () {
        $.ajax({
            url: '{{ path('obtener_legajos_investigacion') }}',
            type: 'GET',
            dataType: 'JSON',
            data: {
                fondoid: fondoSelect.val()
            },
            success: function (legajos) {
                legajoSelect.prop('disabled', false).html('');
                expedienteSelect.prop('disabled', true).html('');

                appendOption(legajoSelect, '', '', {hidden: true, disabled: true, selected: true});

                $.each(legajos, function (key, legajo) {
                    appendOption(legajoSelect, legajo.id, legajo.numero);
                });
            },
            error: function () {
                errorMessage()
            }
        });

        $.ajax({
            url: '{{ path('obtener_libros_investigacion') }}',
            type: 'GET',
            dataType: 'JSON',
            data: {
                fondoid: fondoSelect.val()
            },
            success: function (libros) {
                libroSelect.prop('disabled', false).html('');

                $.each(libros, function (key, libro) {
                    appendOption(libroSelect, libro.id, libro.numero);
                });
            },
            error: function () {
                errorMessage()
            }
        });
    });

    legajoSelect.change(function () {
        $.ajax({
            url: '{{ path('obtener_expedientes_investigacion') }}',
            type: 'GET',
            dataType: 'JSON',
            data: {
                legajoid: legajoSelect.val(),
                fondoid: fondoSelect.val()
            },
            success: function (expedientes) {
                expedienteSelect.prop('disabled', false).html('');

                $.each(expedientes, function (key, expediente) {
                    appendOption(expedienteSelect, expediente.id, expediente.numero);
                });
            },
            error: function () {
                errorMessage()
            }
        });
    });
</script>
