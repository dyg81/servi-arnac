{% extends '@Dyg81Modal/baseModal.html.twig' %}

{% block modalSize %}modal-lg{% endblock %}

{% block modalBackdrop %}
    data-backdrop="static"
{% endblock %}

{% block modalContent %}
    <div class="modal-header">
        <h5 class="modal-title m-0 font-weight-bold text-secondary">
            <i class="fas fa-fw fa-share-square"></i>
            Detalles del Servicio
        </h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">×</span>
        </button>
    </div>
    <div class="modal-body">
        <div class="callout callout-info mt-3">
            <h6 class="font-weight-bold">
                Cliente:
                <a class="font-weight-lighter text-decoration-none text-white-50">{{ investigacion.cliente }}</a>
            </h6>
            <a class="font-weight-bold text-decoration-none text-white">Fondo a investigar: </a>
            <a class="font-weight-lighter text-decoration-none text-white-50">{{ investigacion.fondo }}</a>
            <div class="pt-3">
                <table class="table table-hover" id="investigaciones">
                    <thead>
                        <tr>
                            <th scope="col">Documento(s)</th>
                            <th scope="col">Estado</th>
                            <th scope="col"><span class="sr-only">Acciones</span></th>
                            <th scope="col"><span class="sr-only">Acciones</span></th>
                            <th scope="col"><span class="sr-only">Acciones</span></th>
                            <th scope="col"><span class="sr-only">Acciones</span></th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for expediente in investigacion.expedientes %}
                        <tr>
                            <td class="text-sm">Expediente {{ expediente.numero }}</td>
                            <td>
                                <p class="badge badge-info text-white">{{ expediente.getEstadoExpediente }}</p>
                            </td>
                            {% if investigacion.estado == constant('App\\Entity\\Investigacion::ESTADO_SALA_CLIENTE') or investigacion.estado == constant('App\\Entity\\Investigacion::ESTADO_PAUSADO') %}
                                {% if expediente.estado == constant('App\\Entity\\Expediente::EXP_ESTADO_EN_VITRINA') %}
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                {% else %}
                                    <td class="text-sm">
                                        <div class="float-right pr-2">
                                            <form method="post" action="{{ path('sala_agregar_reprografia', {'documento': expediente.id, 'investigacion': investigacion.id, 'tipo': 'expediente'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('sala_agregar_reprografia') }}"><button type="submit" class="text-muted mr-2 border-0 bg-transparent" title="Solicitar reprografía" aria-label="Solicitar reprografía"><i class="far fa-scanner-image"></i></button></form>
                                        </div>
                                    </td>
                                    <td class="text-sm">
                                        <div class="float-right pr-2">
                                            <form method="post" action="{{ path('sala_agregar_transcripcion', {'documento': expediente.id, 'investigacion': investigacion.id, 'tipo': 'expediente'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('sala_agregar_transcripcion') }}"><button type="submit" class="text-muted mr-2 border-0 bg-transparent" title="Solicitar transcripción" aria-label="Solicitar transcripción"><i class="far fa-signature"></i></button></form>
                                        </div>
                                    </td>
                                    <td class="text-sm">
                                        <div class="float-right pr-2">
                                            <form method="post" action="{{ path('sala_agregar_certificacion', {'documento': expediente.id, 'investigacion': investigacion.id, 'tipo': 'expediente'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('sala_agregar_certificacion') }}"><button type="submit" class="text-muted mr-2 border-0 bg-transparent" title="Solicitar certificación" aria-label="Solicitar certificación"><i class="far fa-file-certificate"></i></button></form>
                                        </div>
                                    </td>
                                {% endif %}
                                <td class="text-sm">
                                    <div class="float-right pr-2">
                                        {% if not(expediente.estado == constant('App\\Entity\\Expediente::EXP_ESTADO_EN_VITRINA')) %}
                                            <form method="post" action="{{ path('sala_archivar_documento_en_vitrina', {'documento': expediente.id, 'investigacion': investigacion.id, 'tipo': 'expediente'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('sala_archivar_documento_en_vitrina') }}"><button type="submit" class="text-muted mr-2" title="Guardar en vitrina" aria-label="Guardar en vitrina"><i class="fas fa-arrow-alt-from-left"></i></button></form>
                                        {% else %}
                                            <form method="post" action="{{ path('sala_regresar_documento_de_vitrina', {'documento': expediente.id, 'investigacion': investigacion.id, 'tipo': 'expediente'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('sala_regresar_documento_de_vitrina') }}"><button type="submit" class="text-muted mr-2" title="Retirar de vitrina" aria-label="Retirar de vitrina"><i class="fas fa-arrow-alt-from-right"></i></button></form>
                                        {% endif %}
                                    </div>
                                </td>
                            {% else %}
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                    {% for libro in investigacion.libros %}
                        <tr>
                            <td class="text-sm">Libro {{ libro }}</td>
                            <td>
                                <p class="badge badge-info text-white">{{ libro.getEstadolibro }}</p>
                            </td>
                            {% if investigacion.estado == constant('App\\Entity\\Investigacion::ESTADO_SALA_CLIENTE') or investigacion.estado == constant('App\\Entity\\Investigacion::ESTADO_PAUSADO') %}
                                {% if libro.estado == constant('App\\Entity\\Libro::LIB_ESTADO_EN_VITRINA') %}
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                {% else %}
                                    <td class="text-sm">
                                        <div class="float-right pr-2">
                                            <form method="post" action="{{ path('sala_agregar_reprografia', {'documento': libro.id, 'investigacion': investigacion.id, 'tipo': 'libro'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('sala_agregar_reprografia') }}"><button type="submit" class="text-muted mr-2 border-0 bg-transparent" title="Solicitar reprografía" aria-label="Solicitar reprografía"><i class="far fa-scanner-image"></i></button></form>
                                        </div>
                                    </td>
                                    <td class="text-sm">
                                        <div class="float-right pr-2">
                                            <form method="post" action="{{ path('sala_agregar_transcripcion', {'documento': libro.id, 'investigacion': investigacion.id, 'tipo': 'libro'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('sala_agregar_transcripcion') }}"><button type="submit" class="text-muted mr-2 border-0 bg-transparent" title="Solicitar transcripción" aria-label="Solicitar transcripción"><i class="far fa-signature"></i></button></form>
                                        </div>
                                    </td>
                                    <td class="text-sm">
                                        <div class="float-right pr-2">
                                            <form method="post" action="{{ path('sala_agregar_certificacion', {'documento': libro.id, 'investigacion': investigacion.id, 'tipo': 'libro'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('sala_agregar_certificacion') }}"><button type="submit" class="text-muted mr-2 border-0 bg-transparent" title="Solicitar certificación" aria-label="Solicitar certificación"><i class="far fa-file-certificate"></i></button></form>
                                        </div>
                                    </td>
                                {% endif %}
                                <td class="text-sm">
                                    <div class="float-right pr-2">
                                        {% if not(libro.estado == constant('App\\Entity\\Libro::LIB_ESTADO_EN_VITRINA')) %}
                                            <form method="post" action="{{ path('sala_archivar_documento_en_vitrina', {'documento': libro.id, 'investigacion': investigacion.id, 'tipo': 'libro'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('sala_archivar_documento_en_vitrina') }}"><button type="submit" class="text-muted mr-2" title="Guardar en vitrina" aria-label="Guardar en vitrina"><i class="fas fa-arrow-alt-from-left"></i></button></form>
                                        {% else %}
                                            <form method="post" action="{{ path('sala_regresar_documento_de_vitrina', {'documento': libro.id, 'investigacion': investigacion.id, 'tipo': 'libro'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('sala_regresar_documento_de_vitrina') }}"><button type="submit" class="text-muted mr-2" title="Retirar de vitrina" aria-label="Retirar de vitrina"><i class="fas fa-arrow-alt-from-right"></i></button></form>
                                        {% endif %}
                                    </div>
                                </td>
                            {% else %}
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <div class="col-3">
            {% if investigacion.estado == constant('App\\Entity\\Investigacion::ESTADO_PROCESADO') %}
                <form method="post" action="{{ path('sala_entregar_documentos_investigacion', {'id': investigacion.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('sala_entregar_documentos_investigacion') }}"><button type="submit" class="btn btn-sm btn-danger" style="margin-left: -10.5rem !important;">Entregar Documentos</button></form>
            {% elseif investigacion.estado == constant('App\\Entity\\Investigacion::ESTADO_SALA_CLIENTE') or investigacion.estado == constant('App\\Entity\\Investigacion::ESTADO_PAUSADO') %}
                <form method="post" action="{{ path('sala_recoger_documentos_investigacion', {'id': investigacion.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('sala_recoger_documentos_investigacion') }}"><button type="submit" class="btn btn-sm btn-danger" style="margin-left: -10.5rem !important;">Recoger Documentos</button></form>
            {% endif %}
        </div>
        <div class="col-3">
            {% if (investigacion.estado != constant('App\\Entity\\Investigacion::ESTADO_SALA_CLIENTE') and (investigacion.estado != constant('App\\Entity\\Investigacion::ESTADO_PAUSADO'))) %}
                <form method="post" action="{{ path('sala_cancelar_investigacion', {'id': investigacion.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('sala_cancelar_investigacion') }}"><button type="submit" class="btn btn-sm btn-primary" style="margin-left: -12rem !important;">Cancelar Servicio</button></form>
            {% endif %}
        </div>
        <div class="col-3">
            <button type="button" class="btn btn-sm btn-default float-right" data-dismiss="modal">Cerrar</button>
        </div>
    </div>
    <script>
        $('[data-toggle="tooltip"]').tooltip(
            {
                delay: {show: 300, hide: 0},
            }
        );
    </script>
{% endblock %}

