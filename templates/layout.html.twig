{% extends 'base.html.twig' %}

{% block body_classes %}
    sidebar-mini sidebar-collapse layout-fixed layout-navbar-fixed dark-mode animsition
{% endblock %}

{% block body %}
    <div class="wrapper">
        <nav class="main-header navbar navbar-expand navbar-dark">
            <ul class="navbar-nav ml-auto mr-3">
                {% if not(app.user.roles[0] == 'ROLE_ADMIN') and not(app.user.roles[0] == 'ROLE_REGISTRO') %}
                    <li class="nav-item dropdown">
                        <a id="notificationBell" class="nav-link" data-toggle="dropdown" href="#">
                            <i class="fas fa-bell mt-1"></i>
                        </a>
                        <div id="notificationsBlock" hidden class="dropdown-menu dropdown-menu-lg dropdown-menu-right">
                            {% block notificationes %}{% endblock %}
                        </div>
                    </li>
                {% endif %}
                <li class="nav-item dropdown user-menu">
                    <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown">
                        <img src="{{ asset('assets/dist/img/user.png') }}" class="user-image img-circle elevation-2" alt="User Image">
                    </a>
                    <ul class="dropdown-menu dropdown-menu-right">
                        <li class="user-header bg-secondary">
                            <img src="{{ asset('assets/dist/img/user.png') }}" class="img-circle elevation-2" alt="User Image">
                            <p>
                                <small class="font-italic">{{ app.user.nombre }}</small>
                                <div class="mt-n2 font-weight-bold">
                                    {% if app.user.roles[0] == 'ROLE_ADMIN' %}
                                        Administrador del Sistema
                                    {% elseif app.user.roles[0] == 'ROLE_SALA' %}
                                        Jefe de Sala de Lectura
                                    {% elseif app.user.roles[0] == 'ROLE_ESTACIONARIO' %}
                                        Estacionario
                                    {% elseif app.user.roles[0] == 'ROLE_REGISTRO' %}
                                        Técnico Archivista
                                    {% elseif  app.user.roles[0] == 'ROLE_DIRECTIVO' %}
                                        Directivo
                                    {% elseif  app.user.roles[0] == 'ROLE_TRANSCRIPCION' %}
                                        Especialista en Paleología
                                    {% elseif  app.user.roles[0] == 'ROLE_REPROGRAFIA' %}
                                        Especialista en Reprografía
                                    {% elseif  app.user.roles[0] == 'ROLE_CERTIFICACION' %}
                                        Especialista en Certificación
                                    {% endif %}
                                </div>
                            </p>
                        </li>
                        <li class="user-footer">
                            <div class="row">
                                <div class="col-4">
                                    {% if app.user.roles[0] == 'ROLE_SALA' %}
                                        <a id="pwd-change" href="{{ path('sala_editar_contrasena', {'id': app.user.id, 'ruta': app.request.attributes.get('_route')}) }}" class="btn btn-block btn-sm btn-default pl-2 modal-open" data-toggle="tooltip" data-placement="bottom" data-container=".user-footer" title="Cambiar Contraseña">
                                            <i class="fas fa-lock"></i>
                                        </a>
                                    {% elseif app.user.roles[0] == 'ROLE_ESTACIONARIO' %}
                                        <a id="pwd-change" href="{{ path('estacionario_editar_contrasena', {'id': app.user.id, 'ruta': app.request.attributes.get('_route')}) }}" class="btn btn-block btn-sm btn-default pl-2 modal-open" data-toggle="tooltip" data-placement="bottom" data-container=".user-footer" title="Cambiar Contraseña">
                                            <i class="fas fa-lock"></i>
                                        </a>
                                    {% elseif app.user.roles[0] == 'ROLE_REGISTRO' %}
                                        <a id="pwd-change" href="{{ path('registro_editar_contrasena', {'id': app.user.id, 'ruta': app.request.attributes.get('_route')}) }}" class="btn btn-block btn-sm btn-default pl-2 modal-open" data-toggle="tooltip" data-placement="bottom" data-container=".user-footer" title="Cambiar Contraseña">
                                            <i class="fas fa-lock"></i>
                                        </a>
                                    {% elseif  app.user.roles[0] == 'ROLE_DIRECTIVO' %}
                                        <a id="pwd-change" href="{{ path('direccion_editar_contrasena', {'id': app.user.id, 'ruta': app.request.attributes.get('_route')}) }}" class="btn btn-block btn-sm btn-default pl-2 modal-open" data-toggle="tooltip" data-placement="bottom" data-container=".user-footer" title="Cambiar Contraseña">
                                            <i class="fas fa-lock"></i>
                                        </a>
                                    {% elseif  app.user.roles[0] == 'ROLE_TRANSCRIPCION' %}
                                        <a id="pwd-change" href="{{ path('transcripcion_editar_contrasena', {'id': app.user.id, 'ruta': app.request.attributes.get('_route')}) }}" class="btn btn-block btn-sm btn-default pl-2 modal-open" data-toggle="tooltip" data-placement="bottom" data-container=".user-footer" title="Cambiar Contraseña">
                                            <i class="fas fa-lock"></i>
                                        </a>
                                    {% elseif  app.user.roles[0] == 'ROLE_REPROGRAFIA' %}
                                        <a id="pwd-change" href="{{ path('reprografia_editar_contrasena', {'id': app.user.id, 'ruta': app.request.attributes.get('_route')}) }}" class="btn btn-block btn-sm btn-default pl-2 modal-open" data-toggle="tooltip" data-placement="bottom" data-container=".user-footer" title="Cambiar Contraseña">
                                            <i class="fas fa-lock"></i>
                                        </a>
                                    {% elseif  app.user.roles[0] == 'ROLE_CERTIFICACION' %}
                                        <a id="pwd-change" href="{{ path('certificacion_editar_contrasena', {'id': app.user.id, 'ruta': app.request.attributes.get('_route')}) }}" class="btn btn-block btn-sm btn-default pl-2 modal-open" data-toggle="tooltip" data-placement="bottom" data-container=".user-footer" title="Cambiar Contraseña">
                                            <i class="fas fa-lock"></i>
                                        </a>
                                    {% endif %}
                                </div>
                                <div class="col-4 offset-4">
                                    <form method="post" action="{{ path('sac_cerrar') }}" class="m-0">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                                        <button type="submit" class="btn btn-block btn-sm btn-default" data-toggle="tooltip" data-placement="bottom" data-container=".user-footer" title="Cerrar Sesión">
                                            <i class="fas fa-share"></i>
                                        </button>
                                    </form>
                                </div>

                            </div>
                        </li>
                    </ul>
                </li>
            </ul>
        </nav>

        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <span class="brand-link pl-2">
                <img src="{{ asset('assets/dist/img/arnac-logo-white.png') }}" alt="ARNAC Logo" class="brand-image img-circle elevation-3" style="opacity: .8">
                <span class="brand-text font-weight-light font-italic pl-3">Servi ARNAC</span>
            </span>
            {% block menu %}{% endblock %}
        </aside>

        <div class="content-wrapper text-xs">
            {% block content %}{% endblock %}
        </div>

        <footer class="main-footer text-xs">
            <div class="float-right d-none d-sm-inline">
                ARNAC - Por la preservación de la memoria histórica.
            </div>
            &copy; {{ "now"|date("Y") }} <strong>Todos los derechos reservados.</strong>
        </footer>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script>
        {% for type, msgs in app.session.flashBag.all() %}
            {% for msg in msgs %}
                (function () {
                    const inputText = {{ msg|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_QUOT'))|raw }};
                    const font = "0.875rem Nimrod MT";
                    const canvas = document.createElement("canvas");
                    const context = canvas.getContext("2d");
                    context.font = font;
                    const formattedWidth = Math.ceil(context.measureText(inputText).width) + 100;

                    Toast.fire({
                        icon: {{ type|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_QUOT'))|raw }},
                        title: inputText,
                        width: formattedWidth,
                    });
                })();
            {% endfor %}
        {% endfor %}
    </script>
{% endblock %}
