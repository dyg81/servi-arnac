# Copy outside version control to .env.prod and restrict it (chmod 600).
RELEASE_TAG=2026-11-06
APP_DOMAIN=sac.example.org
APP_SECRET=replace-with-a-long-random-secret
HASHER_ENTROPY=replace-with-the-deployment-hashids-entropy
HASHER_PADDING=8
HASHER_CUSTOM_ALPHABET=abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890
DATABASE_URL=mysql://sac_user:replace-me@db:3306/sac_db?serverVersion=mariadb-10.4.34
MYSQL_DATABASE=sac_db
MYSQL_USER=sac_user
MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-me-too
